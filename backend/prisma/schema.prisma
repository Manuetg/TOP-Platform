generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  VIEWER
}

enum ResourceStatus {
  ACTIVE
  OUT_OF_SERVICE
  ARCHIVED
}

enum AmenityCategory {
  CONNECTIVITY
  CLIMATE
  BATHROOM
  KITCHEN
  ENTERTAINMENT
  OUTDOOR
  PARKING
  SERVICES
  ACCESSIBILITY
  GENERAL
}

enum RatePlanStatus {
  ACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BlockType {
  MAINTENANCE
  OWNER_USE
  OTHER
}

enum BlockStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum IntegrationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MessagingChannel {
  WHATSAPP
}

enum ConversationMode {
  BOT
  HUMAN
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum InboundMessageType {
  TEXT
  IMAGE
  DOCUMENT
  LOCATION
  INTERACTIVE
}

enum OutboundMessageType {
  BOOKING_CONFIRMATION
  CONVERSATION_REPLY
}

enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  displayName      String?
  emailVerifiedAt  DateTime?
  status          UserStatus               @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  localCredential LocalCredential?
  memberships     UserBusinessMembership[]
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  passwordResetChallenges PasswordResetChallenge[]
  emailVerificationTokens EmailVerificationToken[]
}

model UserBusinessMembership {
  id         String         @id @default(uuid())
  userId     String
  businessId String
  role       MembershipRole
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
}

model LocalCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id                  String          @id @default(uuid())
  userId              String
  tokenHash           String          @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replacedSession     RefreshSession? @relation("RefreshSessionReplacement")

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id          String   @id @default(uuid())
  userId      String
  codeDigest  String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  lastSentAt  DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id                    String                   @id @default(uuid())
  businessNumber        Int?
  name                  String
  legalName             String?
  taxId                 String?
  timezone              String                   @default("America/Asuncion")
  currency              String                   @default("PYG")
  status                BusinessStatus           @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  memberships           UserBusinessMembership[]
  resources             Resource[]
  resourceImages        ResourceImage[]
  ratePlans             RatePlan[]
  contacts              Contact[]
  blocks                Block[]
  bookings              Booking[]
  pricingSnapshots      PricingSnapshot[]
  bookingTimelineEvents BookingTimelineEvent[]
  integrationOutboxEvents IntegrationOutboxEvent[]
  availabilityRule      AvailabilityRule?
  amenities             Amenity[]
  payments              Payment[]
  paymentPlans          PaymentPlan[]
  subscription          BusinessSubscription?
  outboundMessages      OutboundMessage[]
  conversations         Conversation[]
  inboundMessages       InboundMessage[]
  conversationSessions   ConversationSession[]
  conversationBotEvents  ConversationBotEvent[]
}

model SubscriptionPlan {
  code         String @id
  name         String
  maxResources Int
  subscriptions BusinessSubscription[]
}

model BusinessSubscription {
  businessId String @id
  planCode String @default("TOP_INITIAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  upgradeRequestedAt DateTime?
  upgradeRequestedBy String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)
}

model AvailabilityRule {
  businessId                String   @id
  pendingBlocksAvailability Boolean  @default(true)
  bufferBeforeDays          Int      @default(0)
  bufferAfterDays           Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  business                  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Contact {
  id             String        @id @default(uuid())
  businessId     String
  name           String
  lastName       String?
  phone          String?
  whatsapp       String?
  email          String?
  documentType   String?
  documentNumber String?
  country        String?
  city           String?
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  archivedAt     DateTime?
  archivedBy     String?
  archivedFromStatus ContactStatus?
  bookings       Booking[]
  conversations  Conversation[]

  @@index([businessId, name, lastName])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, documentNumber])
}

model Resource {
  id                      String             @id @default(uuid())
  businessId              String
  name                    String
  internalCode            String
  description             String?
  capacityMinimum         Int                @default(1)
  capacityMaximum         Int
  capacityMaximumChildren Int                @default(0)
  status                  ResourceStatus     @default(ACTIVE)
  sortOrder               Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  business                Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  images                  ResourceImage[]
  amenities               ResourceAmenity[]
  ratePlanResources       RatePlanResource[]
  blocks                  Block[]
  bookingResources        BookingResource[]

  @@unique([businessId, internalCode])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
}

model Amenity {
  id                String            @id @default(uuid())
  businessId        String?
  code              String            @unique
  name              String
  category          AmenityCategory
  active            Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resourceAmenities ResourceAmenity[]

  @@index([active, category, sortOrder])
  @@index([businessId, active, category, sortOrder])
}

model ResourceAmenity {
  resourceId String
  amenityId  String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([resourceId, amenityId])
  @@unique([resourceId, amenityId])
  @@index([resourceId])
  @@index([amenityId])
}

model ResourceImage {
  id         String   @id @default(uuid())
  businessId String
  resourceId String
  storageKey String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([resourceId, sortOrder])
  @@index([businessId])
  @@index([resourceId])
}

model RatePlan {
  id                     String             @id @default(uuid())
  businessId             String
  name                   String
  description            String?
  baseNightlyAmountMinor BigInt
  status                 RatePlanStatus     @default(ACTIVE)
  validFrom              DateTime?          @db.Date
  validTo                DateTime?          @db.Date
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resources              RatePlanResource[]
  seasonalRates          SeasonalRate[]

  @@index([businessId, status])
  @@index([businessId, validFrom, validTo])
}

model SeasonalRate {
  id          String   @id @default(uuid())
  ratePlanId  String
  name        String
  amountMinor BigInt
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId])
  @@index([ratePlanId, startDate, endDate])
}

model RatePlanResource {
  ratePlanId String
  resourceId String
  createdAt  DateTime @default(now())
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([ratePlanId, resourceId])
  @@unique([ratePlanId, resourceId])
  @@index([resourceId])
}

model Block {
  id                 String      @id @default(uuid())
  businessId         String
  resourceId         String
  type               BlockType
  reason             String
  notes              String?
  startsAt           DateTime
  endsAt             DateTime
  status             BlockStatus @default(SCHEDULED)
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resource           Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt, endsAt, id])
  @@index([businessId, resourceId, startsAt])
}

model Booking {
  id              String                 @id @default(uuid())
  businessId      String
  status          BookingStatus          @default(DRAFT)
  contactId       String?
  checkInDate     DateTime?              @db.Date
  checkOutDate    DateTime?              @db.Date
  adults          Int?
  children        Int?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact         Contact?               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  resources       BookingResource[]
  pricingSnapshot PricingSnapshot?
  payments        Payment[]
  paymentPlan     PaymentPlan?
  timelineEvents  BookingTimelineEvent[]

  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, contactId])
}

model Payment {
  id String @id @default(uuid())
  businessId String
  bookingId String
  amountMinor BigInt
  currency String
  method PaymentMethod
  reference String?
  note String?
  paidAt DateTime
  recordedByUserId String
  status PaymentStatus @default(RECORDED)
  idempotencyKey String
  requestFingerprint String
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
  applications PaymentApplication[]
  @@unique([businessId,idempotencyKey])
  @@index([businessId,bookingId,paidAt,id])
}

model PaymentPlan {
  id                 String                   @id @default(uuid())
  businessId         String
  bookingId          String                   @unique
  currency           String
  totalAmountMinor   BigInt
  createdByUserId    String
  updatedByUserId    String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking            Booking                  @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict)
  installments       PaymentPlanInstallment[]

  @@unique([bookingId, businessId])
  @@index([businessId, bookingId])
}

model PaymentPlanInstallment {
  id            String               @id @default(uuid())
  paymentPlanId String
  amountMinor   BigInt
  dueDate       DateTime?             @db.Date
  sortOrder     Int
  paymentPlan   PaymentPlan           @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  applications  PaymentApplication[]

  @@unique([paymentPlanId, sortOrder])
  @@index([paymentPlanId, dueDate])
}

model PaymentApplication {
  paymentId    String
  installmentId String
  amountMinor  BigInt
  createdAt    DateTime               @default(now())
  payment      Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment  PaymentPlanInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@id([paymentId, installmentId])
  @@index([installmentId])
}

model BookingTimelineEvent {
  id          String   @id @default(uuid())
  businessId  String
  bookingId   String
  type        String
  occurredAt  DateTime @default(now())
  actorUserId String?
  details     Json
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking     Booking  @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, bookingId, occurredAt, id])
}

model IntegrationOutboxEvent {
  eventId       String   @id
  eventType     String
  payloadVersion Int
  businessId    String
  aggregateType String
  aggregateId   String
  occurredAt    DateTime
  correlationId String
  payload       Json
  createdAt     DateTime @default(now())
  status        IntegrationOutboxStatus @default(PENDING)
  attemptCount  Int      @default(0)
  availableAt   DateTime @default(now())
  processingStartedAt DateTime?
  processedAt   DateTime?
  lastError     String?
  processingToken String?
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt, eventId])
  @@index([eventType, createdAt, eventId])
  @@index([status, availableAt, createdAt, eventId])
}

model OutboundMessage {
  id                 String               @id @default(uuid())
  businessId         String
  integrationEventId String
  channel            MessagingChannel
  recipient          String
  messageType        OutboundMessageType
  status             OutboundMessageStatus @default(PENDING)
  payload            Json
  providerMessageId  String?
  createdAt          DateTime             @default(now())
  sentAt             DateTime?
  failedAt           DateTime?
  lastError          String?
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([integrationEventId, messageType, channel])
  @@index([businessId, createdAt, id])
  @@index([businessId, status, createdAt, id])
}

model Conversation {
  id                  String             @id @default(uuid())
  businessId          String
  channel             MessagingChannel
  externalParticipant String
  contactId           String?
  mode                ConversationMode  @default(BOT)
  status              ConversationStatus @default(ACTIVE)
  createdAt           DateTime           @default(now())
  lastMessageAt       DateTime
  closedAt            DateTime?
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact             Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inboundMessages     InboundMessage[]
  session             ConversationSession?
  botEvents           ConversationBotEvent[]

  @@unique([id, businessId])
  @@index([businessId, channel, externalParticipant, status, lastMessageAt, id])
  @@index([businessId, status, lastMessageAt, id])
}

enum ConversationSessionState {
  START
  MAIN_MENU
  AVAILABILITY_ASK_CHECK_IN
  AVAILABILITY_ASK_CHECK_OUT
  AVAILABILITY_ASK_GUESTS
  AVAILABILITY_RESULTS
  PRICING_QUOTE
  CONTACT_ASK_NAME
  BOOKING_CONFIRM
  BOOKING_CREATED
  HUMAN_HANDOFF
}

model ConversationSession {
  id             String                  @id @default(uuid())
  businessId     String
  conversationId String
  state          ConversationSessionState @default(START)
  context        Json
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  expiresAt      DateTime?
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation   Conversation             @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([conversationId, businessId])
  @@index([businessId, state, updatedAt, id])
}

model ConversationBotEvent {
  id                 String       @id @default(uuid())
  businessId         String
  conversationId     String
  inboundMessageId   String
  integrationEventId String
  processedAt        DateTime     @default(now())
  createdAt          DateTime     @default(now())
  business           Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation       Conversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, integrationEventId])
  @@index([businessId, conversationId, processedAt, id])
}

model InboundMessage {
  id                 String             @id @default(uuid())
  businessId         String
  conversationId     String
  channel            MessagingChannel
  providerMessageId  String
  sender             String
  messageType        InboundMessageType
  payload            Json
  receivedAt         DateTime
  createdAt          DateTime           @default(now())
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation       Conversation       @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, channel, providerMessageId])
  @@index([businessId, conversationId, receivedAt, id])
  @@index([businessId, sender, receivedAt, id])
}

model BookingResource {
  bookingId  String
  resourceId String
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model PricingSnapshot {
  id               String   @id @default(uuid())
  businessId       String
  bookingId        String   @unique
  currency         String
  totalAmountMinor BigInt
  items            Json
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
}
