generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  VIEWER
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  localCredential LocalCredential?
  memberships     UserBusinessMembership[]
  refreshSessions RefreshSession[]
}

model UserBusinessMembership {
  id         String         @id @default(uuid())
  userId     String
  businessId String
  role       MembershipRole
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
}

model LocalCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id                  String   @id @default(uuid())
  userId              String
  tokenHash           String   @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   RefreshSession?  @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replacedSession     RefreshSession?  @relation("RefreshSessionReplacement")

  @@index([userId])
}

model Business {
  id             String         @id @default(uuid())
  businessNumber Int?
  name           String
  legalName      String?
  taxId          String?
  timezone       String         @default("America/Asuncion")
  currency       String         @default("PYG")
  status         BusinessStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  memberships    UserBusinessMembership[]
}
