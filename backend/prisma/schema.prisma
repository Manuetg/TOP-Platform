generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  VIEWER
}

enum ResourceStatus {
  ACTIVE
  OUT_OF_SERVICE
  ARCHIVED
}

enum AmenityCategory {
  CONNECTIVITY
  CLIMATE
  BATHROOM
  KITCHEN
  ENTERTAINMENT
  OUTDOOR
  PARKING
  SERVICES
  ACCESSIBILITY
  GENERAL
}

enum RatePlanStatus {
  ACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BlockType {
  MAINTENANCE
  OWNER_USE
  OTHER
}

enum BlockStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
}

model User {
  financeEvidenceFiles FinanceEvidenceFile[] @relation("FinanceEvidenceFileActor")
  v2FinanceImportBatchActor FinanceImportBatch[] @relation("FinanceImportBatchActor")
  v2FinanceExpenseTemplateActor FinanceExpenseTemplate[] @relation("FinanceExpenseTemplateActor")
  v2FinanceExpenseTemplateRevisionActor FinanceExpenseTemplateRevision[] @relation("FinanceExpenseTemplateRevisionActor")
  v2FinanceExpenseDraftCreator FinanceExpenseDraft[] @relation("FinanceExpenseDraftCreator")
  v2FinanceExpenseDraftActor FinanceExpenseDraft[] @relation("FinanceExpenseDraftActor")
  v2FinanceApprovalPolicyRevisionActor FinanceApprovalPolicyRevision[] @relation("FinanceApprovalPolicyRevisionActor")
  v2FinanceDraftDecisionActor FinanceDraftDecision[] @relation("FinanceDraftDecisionActor")
  v2FinanceReimbursementDraftActor FinanceReimbursementDraft[] @relation("FinanceReimbursementDraftActor")
  v2FinanceReimbursementClaimActor FinanceReimbursementClaim[] @relation("FinanceReimbursementClaimActor")
  v2FinanceBankStatementActor FinanceBankStatement[] @relation("FinanceBankStatementActor")
  v2FinanceBankMatchActor FinanceBankMatch[] @relation("FinanceBankMatchActor")
  v2FinanceBankMatchCancelActor FinanceBankMatch[] @relation("FinanceBankMatchCancelActor")
  v2FinanceBankFeeOriginActor FinanceBankFeeOrigin[] @relation("FinanceBankFeeOriginActor")
  v2FinanceAllocationRuleActor FinanceAllocationRule[] @relation("FinanceAllocationRuleActor")
  v2FinanceAllocationRuleRevisionActor FinanceAllocationRuleRevision[] @relation("FinanceAllocationRuleRevisionActor")
  v2FinanceCostAllocationActor FinanceCostAllocation[] @relation("FinanceCostAllocationActor")
  v2FinanceLaborCostActor FinanceLaborCost[] @relation("FinanceLaborCostActor")
  v2FinanceLaborCostRevisionActor FinanceLaborCostRevision[] @relation("FinanceLaborCostRevisionActor")
  v2FinanceBudgetActor FinanceBudget[] @relation("FinanceBudgetActor")
  v2FinanceBudgetRevisionActor FinanceBudgetRevision[] @relation("FinanceBudgetRevisionActor")
  v2FinanceBudgetRevisionApprover FinanceBudgetRevision[] @relation("FinanceBudgetRevisionApprover")
  v2FinanceCommitmentActor FinanceCommitment[] @relation("FinanceCommitmentActor")
  v2FinanceCommitmentCancelActor FinanceCommitment[] @relation("FinanceCommitmentCancelActor")
  v2FinanceCommitmentConversionActor FinanceCommitmentConversion[] @relation("FinanceCommitmentConversionActor")
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateActor")
  financeTerminalRecognitions FinanceTerminalRecognition[] @relation("FinanceTerminalRecognitionActor")
  financeCloseSnapshots FinanceCloseSnapshot[] @relation("FinanceCloseSnapshotActor")
  financeCloseEvents FinanceCloseEvent[] @relation("FinanceCloseEventActor")
  recordedPaymentAdjustments PaymentAdjustment[] @relation("PaymentAdjustmentActor")
  id              String                   @id @default(uuid())
  email           String                   @unique
  displayName      String?
  birthYear        Int?
  username         String?
  phone            String?
  avatarId         String?
  emailVerifiedAt  DateTime?
  status          UserStatus               @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  localCredential LocalCredential?
  memberships     UserBusinessMembership[]
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  passwordResetChallenges PasswordResetChallenge[]
  emailVerificationTokens EmailVerificationToken[]
  displayNameAudits UserDisplayNameAudit[] @relation("DisplayNameAuditSubject")
  displayNameAuditActions UserDisplayNameAudit[] @relation("DisplayNameAuditActor")
  profileAudits UserProfileAudit[] @relation("ProfileAuditSubject")
  profileAuditActions UserProfileAudit[] @relation("ProfileAuditActor")
  businessProfileAuditActions BusinessProfileAudit[] @relation("BusinessProfileAuditActor")
  pricingRevisionActions PricingRevision[]
}

model UserDisplayNameAudit {
  id          String   @id @default(uuid())
  userId      String
  actorUserId String
  occurredAt  DateTime @default(now())
  beforeName  String?
  afterName   String
  reason      String
  user        User     @relation("DisplayNameAuditSubject", fields: [userId], references: [id], onDelete: Restrict)
  actor       User     @relation("DisplayNameAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt, id])
}

model UserProfileAudit {
  id          String   @id @default(uuid())
  userId      String
  actorUserId String
  occurredAt  DateTime @default(now())
  beforeData  Json
  afterData   Json
  reason      String
  user        User     @relation("ProfileAuditSubject", fields: [userId], references: [id], onDelete: Restrict)
  actor       User     @relation("ProfileAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt, id])
}

model UserBusinessMembership {
  id         String         @id @default(uuid())
  userId     String
  businessId String
  role       MembershipRole
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([userId, businessId])
  @@index([businessId])
}

model LocalCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id                  String          @id @default(uuid())
  userId              String
  tokenHash           String          @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBySession   RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replacedSession     RefreshSession? @relation("RefreshSessionReplacement")

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id          String   @id @default(uuid())
  userId      String
  codeDigest  String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  lastSentAt  DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  financeEvidenceFiles FinanceEvidenceFile[] @relation("FinanceEvidenceFileBusiness")
  v2FinanceImportBatchBusiness FinanceImportBatch[] @relation("FinanceImportBatchBusiness")
  v2FinanceImportItemBusiness FinanceImportItem[] @relation("FinanceImportItemBusiness")
  v2FinanceExpenseTemplateBusiness FinanceExpenseTemplate[] @relation("FinanceExpenseTemplateBusiness")
  v2FinanceExpenseTemplateRevisionBusiness FinanceExpenseTemplateRevision[] @relation("FinanceExpenseTemplateRevisionBusiness")
  v2FinanceExpenseTemplateLineBusiness FinanceExpenseTemplateLine[] @relation("FinanceExpenseTemplateLineBusiness")
  v2FinanceExpenseDraftBusiness FinanceExpenseDraft[] @relation("FinanceExpenseDraftBusiness")
  v2FinanceExpenseDraftLineBusiness FinanceExpenseDraftLine[] @relation("FinanceExpenseDraftLineBusiness")
  v2FinanceApprovalPolicyRevisionBusiness FinanceApprovalPolicyRevision[] @relation("FinanceApprovalPolicyRevisionBusiness")
  v2FinanceDraftDecisionBusiness FinanceDraftDecision[] @relation("FinanceDraftDecisionBusiness")
  v2FinanceReimbursementDraftBusiness FinanceReimbursementDraft[] @relation("FinanceReimbursementDraftBusiness")
  v2FinanceReimbursementClaimBusiness FinanceReimbursementClaim[] @relation("FinanceReimbursementClaimBusiness")
  v2FinanceBankStatementBusiness FinanceBankStatement[] @relation("FinanceBankStatementBusiness")
  v2FinanceBankRowBusiness FinanceBankRow[] @relation("FinanceBankRowBusiness")
  v2FinanceBankMatchBusiness FinanceBankMatch[] @relation("FinanceBankMatchBusiness")
  v2FinanceBankMatchRowBusiness FinanceBankMatchRow[] @relation("FinanceBankMatchRowBusiness")
  v2FinanceBankMatchComponentBusiness FinanceBankMatchComponent[] @relation("FinanceBankMatchComponentBusiness")
  v2FinanceBankFeeOriginBusiness FinanceBankFeeOrigin[] @relation("FinanceBankFeeOriginBusiness")
  v2FinanceAllocationRuleBusiness FinanceAllocationRule[] @relation("FinanceAllocationRuleBusiness")
  v2FinanceAllocationRuleRevisionBusiness FinanceAllocationRuleRevision[] @relation("FinanceAllocationRuleRevisionBusiness")
  v2FinanceAllocationRulePartBusiness FinanceAllocationRulePart[] @relation("FinanceAllocationRulePartBusiness")
  v2FinanceCostAllocationBusiness FinanceCostAllocation[] @relation("FinanceCostAllocationBusiness")
  v2FinanceCostAllocationPartBusiness FinanceCostAllocationPart[] @relation("FinanceCostAllocationPartBusiness")
  v2FinanceLaborCostBusiness FinanceLaborCost[] @relation("FinanceLaborCostBusiness")
  v2FinanceLaborCostRevisionBusiness FinanceLaborCostRevision[] @relation("FinanceLaborCostRevisionBusiness")
  v2FinanceBudgetBusiness FinanceBudget[] @relation("FinanceBudgetBusiness")
  v2FinanceBudgetRevisionBusiness FinanceBudgetRevision[] @relation("FinanceBudgetRevisionBusiness")
  v2FinanceBudgetLineBusiness FinanceBudgetLine[] @relation("FinanceBudgetLineBusiness")
  v2FinanceCommitmentBusiness FinanceCommitment[] @relation("FinanceCommitmentBusiness")
  v2FinanceCommitmentConversionBusiness FinanceCommitmentConversion[] @relation("FinanceCommitmentConversionBusiness")
  financeServiceHeads FinanceServiceHead[] @relation("FinanceServiceHeadBusiness")
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateBusiness")
  financeTerminalRecognitions FinanceTerminalRecognition[] @relation("FinanceTerminalRecognitionBusiness")
  financePeriods FinancePeriod[] @relation("FinancePeriodBusiness")
  financeCloseSnapshots FinanceCloseSnapshot[] @relation("FinanceCloseSnapshotBusiness")
  financeCloseEvents FinanceCloseEvent[] @relation("FinanceCloseEventBusiness")
  paymentAdjustments PaymentAdjustment[]
  paymentApplicationReversals PaymentApplicationReversal[]
  id                    String                   @id @default(uuid())
  businessNumber        Int?
  name                  String
  legalName             String?
  taxId                 String?
  country               String?
  region                String?
  city                  String?
  address               String?
  timezone              String                   @default("America/Asuncion")
  currency              String                   @default("PYG")
  status                BusinessStatus           @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  memberships           UserBusinessMembership[]
  resources             Resource[]
  resourceImages        ResourceImage[]
  ratePlans             RatePlan[]
  contacts              Contact[]
  blocks                Block[]
  bookings              Booking[]
  pricingSnapshots      PricingSnapshot[]
  pricingRevisions      PricingRevision[]
  bookingTimelineEvents BookingTimelineEvent[]
  availabilityRule      AvailabilityRule?
  amenities             Amenity[]
  payments              Payment[]
  paymentPlans          PaymentPlan[]
  subscription          BusinessSubscription?
  profileAudits         BusinessProfileAudit[]
  financeCatalogs       FinanceCatalog[]
  financeAccounts       FinanceAccount[]
  financeOpenings       FinanceOpening[]
  financeExpenses       FinanceExpense[]
  financeExpenseLines   FinanceExpenseLine[]
  financeSettlements    FinanceSettlement[]
  financePaymentLinks   FinancePaymentLink[]
  financeTransfers      FinanceTransfer[]
  financeCashMovements  FinanceCashMovement[]
  financeReviews        FinanceReview[]
  financeCashCounts     FinanceCashCount[]
  financeRequests       FinanceRequest[]
  financeAudits         FinanceAudit[]
}

model BusinessProfileAudit {
  id          String   @id @default(uuid())
  businessId  String
  actorUserId String
  occurredAt  DateTime @default(now())
  beforeData  Json
  afterData   Json
  reason      String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor       User     @relation("BusinessProfileAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt, id])
}

model SubscriptionPlan {
  code         String @id
  name         String
  maxResources Int
  subscriptions BusinessSubscription[]
}

model BusinessSubscription {
  businessId String @id
  planCode String @default("TOP_INITIAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  upgradeRequestedAt DateTime?
  upgradeRequestedBy String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Restrict)
}

model AvailabilityRule {
  businessId                String   @id
  pendingBlocksAvailability Boolean  @default(true)
  bufferBeforeDays          Int      @default(0)
  bufferAfterDays           Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  business                  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Contact {
  id             String        @id @default(uuid())
  businessId     String
  name           String
  lastName       String?
  phone          String?
  whatsapp       String?
  email          String?
  documentType   String?
  documentNumber String?
  country        String?
  city           String?
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  archivedAt     DateTime?
  archivedBy     String?
  archivedFromStatus ContactStatus?
  bookings       Booking[]

  @@index([businessId, name, lastName])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([businessId, documentNumber])
}

model Resource {
  v2FinanceTemplateLineResource FinanceExpenseTemplateLine[] @relation("FinanceTemplateLineResource")
  v2FinanceDraftLineResource FinanceExpenseDraftLine[] @relation("FinanceDraftLineResource")
  v2FinanceAllocationRulePartResource FinanceAllocationRulePart[] @relation("FinanceAllocationRulePartResource")
  v2FinanceCostAllocationPartResource FinanceCostAllocationPart[] @relation("FinanceCostAllocationPartResource")
  v2FinanceBudgetLineResource FinanceBudgetLine[] @relation("FinanceBudgetLineResource")
  v2FinanceCommitmentResource FinanceCommitment[] @relation("FinanceCommitmentResource")
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateResource")
  financeTerminalRecognitions FinanceTerminalRecognition[] @relation("FinanceTerminalRecognitionResource")
  id                      String             @id @default(uuid())
  businessId              String
  name                    String
  internalCode            String
  description             String?
  capacityMinimum         Int                @default(1)
  capacityMaximum         Int
  capacityMaximumChildren Int                @default(0)
  status                  ResourceStatus     @default(ACTIVE)
  sortOrder               Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  business                Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  images                  ResourceImage[]
  amenities               ResourceAmenity[]
  ratePlanResources       RatePlanResource[]
  blocks                  Block[]
  bookingResources        BookingResource[]
  financeExpenseLines     FinanceExpenseLine[]

  @@unique([id, businessId])
  @@unique([businessId, internalCode])
  @@index([businessId, status])
  @@index([businessId, sortOrder])
}

model Amenity {
  id                String            @id @default(uuid())
  businessId        String?
  code              String            @unique
  name              String
  category          AmenityCategory
  active            Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resourceAmenities ResourceAmenity[]

  @@index([active, category, sortOrder])
  @@index([businessId, active, category, sortOrder])
}

model ResourceAmenity {
  resourceId String
  amenityId  String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([resourceId, amenityId])
  @@unique([resourceId, amenityId])
  @@index([resourceId])
  @@index([amenityId])
}

model ResourceImage {
  id         String   @id @default(uuid())
  businessId String
  resourceId String
  storageKey String
  mimeType   String
  sizeBytes  Int
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([resourceId, sortOrder])
  @@index([businessId])
  @@index([resourceId])
}

model RatePlan {
  id                     String             @id @default(uuid())
  businessId             String
  name                   String
  description            String?
  baseNightlyAmountMinor BigInt
  status                 RatePlanStatus     @default(ACTIVE)
  validFrom              DateTime?          @db.Date
  validTo                DateTime?          @db.Date
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  business               Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resources              RatePlanResource[]
  seasonalRates          SeasonalRate[]

  @@index([businessId, status])
  @@index([businessId, validFrom, validTo])
}

model SeasonalRate {
  id          String   @id @default(uuid())
  ratePlanId  String
  name        String
  amountMinor BigInt
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId])
  @@index([ratePlanId, startDate, endDate])
}

model RatePlanResource {
  ratePlanId String
  resourceId String
  createdAt  DateTime @default(now())
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([ratePlanId, resourceId])
  @@unique([ratePlanId, resourceId])
  @@index([resourceId])
}

model Block {
  id                 String      @id @default(uuid())
  businessId         String
  resourceId         String
  type               BlockType
  reason             String
  notes              String?
  startsAt           DateTime
  endsAt             DateTime
  status             BlockStatus @default(SCHEDULED)
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  resource           Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt, endsAt, id])
  @@index([businessId, resourceId, startsAt])
}

model Booking {
  v2FinanceTemplateLineBooking FinanceExpenseTemplateLine[] @relation("FinanceTemplateLineBooking")
  v2FinanceDraftLineBooking FinanceExpenseDraftLine[] @relation("FinanceDraftLineBooking")
  v2ExpenseLines FinanceExpenseLine[] @relation("FinanceExpenseLineBooking")
  financeServiceHead FinanceServiceHead? @relation("FinanceServiceHeadBooking")
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateBooking")
  financeTerminalRecognitions FinanceTerminalRecognition[] @relation("FinanceTerminalRecognitionBooking")
  paymentAdjustments PaymentAdjustment[]
  id              String                 @id @default(uuid())
  businessId      String
  status          BookingStatus          @default(DRAFT)
  contactId       String?
  checkInDate     DateTime?              @db.Date
  checkOutDate    DateTime?              @db.Date
  adults          Int?
  children        Int?
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact         Contact?               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  resources       BookingResource[]
  pricingSnapshot PricingSnapshot?
  pricingRevisions PricingRevision[]
  payments        Payment[]
  paymentPlan     PaymentPlan?
  timelineEvents  BookingTimelineEvent[]

  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, contactId])
}

model Payment {
  v2FinanceBankComponentPayment FinanceBankMatchComponent[] @relation("FinanceBankComponentPayment")
  adjustments PaymentAdjustment[]
  id String @id @default(uuid())
  businessId String
  bookingId String
  amountMinor BigInt
  currency String
  method PaymentMethod
  reference String?
  note String?
  paidAt DateTime
  recordedByUserId String
  status PaymentStatus @default(RECORDED)
  idempotencyKey String
  requestFingerprint String
  createdAt DateTime @default(now())
  business Business @relation(fields:[businessId],references:[id],onDelete:Restrict)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
  applications PaymentApplication[]
  financeLink FinancePaymentLink?
  @@unique([id,businessId,bookingId])
  @@unique([id,businessId])
  @@unique([businessId,idempotencyKey])
  @@index([businessId,bookingId,paidAt,id])
}

model PaymentPlan {
  id                 String                   @id @default(uuid())
  businessId         String
  bookingId          String                   @unique
  currency           String
  totalAmountMinor   BigInt
  createdByUserId    String
  updatedByUserId    String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking            Booking                  @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict)
  installments       PaymentPlanInstallment[]

  @@unique([bookingId, businessId])
  @@index([businessId, bookingId])
}

model PaymentPlanInstallment {
  id            String               @id @default(uuid())
  paymentPlanId String
  amountMinor   BigInt
  dueDate       DateTime?             @db.Date
  sortOrder     Int
  paymentPlan   PaymentPlan           @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  applications  PaymentApplication[]

  @@unique([paymentPlanId, sortOrder])
  @@index([paymentPlanId, dueDate])
}

model PaymentApplication {
  reversals PaymentApplicationReversal[]
  paymentId    String
  installmentId String
  amountMinor  BigInt
  createdAt    DateTime               @default(now())
  payment      Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment  PaymentPlanInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@id([paymentId, installmentId])
  @@index([installmentId])
}

model BookingTimelineEvent {
  financeServiceCheckIns FinanceServiceCertificate[] @relation("FinanceServiceCheckIn")
  financeServiceCheckOuts FinanceServiceCertificate[] @relation("FinanceServiceCheckOut")
  @@unique([id, businessId, bookingId])
  id          String   @id @default(uuid())
  businessId  String
  bookingId   String
  type        String
  occurredAt  DateTime @default(now())
  actorUserId String?
  details     Json
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking     Booking  @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, bookingId, occurredAt, id])
}

model BookingResource {
  bookingId  String
  resourceId String
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([bookingId, resourceId])
  @@index([resourceId])
}

model PricingSnapshot {
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateSnapshot")
  id               String   @id @default(uuid())
  businessId       String
  bookingId        String   @unique
  currency         String
  totalAmountMinor BigInt
  items            Json
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  revisions PricingRevision[]

  @@unique([id, businessId, bookingId])
  @@index([businessId, createdAt])
}

model PricingRevision {
  financeServiceCertificates FinanceServiceCertificate[] @relation("FinanceServiceCertificateRevision")
  financeTerminalRecognitions FinanceTerminalRecognition[] @relation("FinanceTerminalRecognitionRevision")
  @@unique([id, businessId, bookingId])
  kind String @default("SERVICE")
  requestId String? @unique
  financeRequest FinanceRequest? @relation("TerminalPricingRequest", fields: [requestId, businessId], references: [id, businessId], onDelete: Restrict)
  @@unique([requestId, businessId])
