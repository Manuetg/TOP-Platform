{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "tempDirName": ".stryker-tmp",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.finance-mutation.config.cjs",
    "enableFindRelatedTests": false
  },
  "reporters": [
    "progress",
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/finance.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/finance.json"
  },
  "mutate": [
    "src/modules/finance/domain/**/*.ts",
    "src/modules/finance/application/**/*.ts",
    "!src/modules/finance/**/*.spec.ts",
    "src/modules/payment/infrastructure/prisma-finance-payment.reader.ts",
    "src/modules/payment/domain/payment-adjustment.rules.ts",
    "src/modules/payment/domain/financial-reconciliation.ts",
    "src/modules/payment/application/get-outstanding-balance.use-case.ts",
    "src/modules/payment/application/payment-plan.use-cases.ts",
    "src/modules/payment/infrastructure/prisma-payment-adjustment.writer.ts",
    "src/modules/payment/infrastructure/prisma-payment-effective.reader.ts",
    "src/modules/payment/infrastructure/prisma-payment-closing.reader.ts",
    "src/modules/payment/infrastructure/prisma-payment-plan.repository.ts",
    "src/modules/payment/infrastructure/prisma-outstanding-balance.repository.ts",
    "src/modules/payment/infrastructure/prisma-payment.repository.ts",
    "src/modules/pricing/domain/terminal-final-amount.ts",
    "src/modules/pricing/infrastructure/prisma-terminal-final-amount.writer.ts",
    "src/modules/pricing/infrastructure/prisma-current-pricing.reader.ts",
    "src/modules/finance/infrastructure/finance-payment-cash.sources.ts",
    "src/modules/finance/infrastructure/finance-movement.mapper.ts",
    "src/modules/finance/infrastructure/finance-report.mapper.ts",
    "src/modules/finance/infrastructure/finance-accumulation.guard.ts",
    "src/modules/finance/infrastructure/finance-v2-accumulation.guard.ts",
    "src/modules/finance/infrastructure/prisma-finance-corrections.reader.ts",
    "src/modules/finance/infrastructure/prisma-finance-corrections.repository.ts",
    "src/modules/finance/infrastructure/finance-recognition.db.ts",
    "src/modules/finance/infrastructure/finance-recognition.source.ts",
    "src/modules/finance/infrastructure/finance-recognition.sources.ts",
    "src/modules/finance/infrastructure/finance-recognition.report.ts",
    "src/modules/finance/infrastructure/finance-recognition.repository.ts",
    "src/modules/finance/infrastructure/finance-recognition-booking-result.reader.ts",
    "src/modules/finance/infrastructure/finance-v2-allocation-labor.handler.ts",
    "src/modules/finance/infrastructure/finance-v2-cost.reader.ts",
    "src/modules/finance/infrastructure/finance-v2-cost.report-reader.ts",
    "src/modules/finance/infrastructure/finance-v2-report.cut.ts",
    "src/modules/finance/infrastructure/finance-composition.resource.ts",
    "src/modules/finance/infrastructure/finance-v2-budget.sql-store.ts",
    "src/modules/finance/infrastructure/finance-v2-budget.comparison-reader.ts",
    "src/modules/finance/infrastructure/finance-v2-draft.sql-store.ts",
    "src/modules/finance/infrastructure/finance-v2-expense.writer.ts",
    "src/modules/finance/infrastructure/finance-v2-planning.read-service.ts",
    "src/modules/finance/infrastructure/finance-v2-receivable.reader.ts",
    "src/modules/finance/infrastructure/finance-composition.public.ts",
    "src/modules/finance/infrastructure/finance-composition.money.ts",
    "src/modules/finance/infrastructure/finance-v2-bank-source.sql-reader.ts",
    "src/modules/finance/infrastructure/finance-v2-bank.read-service.ts",
    "src/modules/finance/infrastructure/finance-v2-bank.lists-reader.ts",
    "src/modules/finance/infrastructure/finance-v2-import-bank.handler.ts",
    "src/modules/finance/infrastructure/finance-v2-import-bank.atomic-writer.ts",
    "src/modules/finance/infrastructure/finance-v2-import-bank.snapshot-reader.ts",
    "src/modules/finance/infrastructure/finance-v2-import-bank.sql-store.ts",
    "src/modules/finance/infrastructure/finance-v2.repository.ts",
    "src/modules/finance/infrastructure/finance-v2-cash.cut.ts",
    "src/modules/finance/infrastructure/finance-v2-payment.cut.ts",
    "src/modules/finance/infrastructure/finance-v2-alerts.read-service.ts",
    "src/modules/finance/infrastructure/finance-v2-evidence.read-service.ts",
    "src/modules/finance/infrastructure/finance-v2-operational.read-service.ts",
    "src/modules/finance/infrastructure/finance-composition.validation.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  }
}
