# Ejemplo exclusivamente local. Copiar a .env; no reutilizar secretos en producción.
# Sin NODE_ENV, el backend conserva development. Producción ignora archivos .env:
# suministrar toda la configuración por el entorno de ejecución.
NODE_ENV=development
DATABASE_URL="postgresql://top:top@localhost:5432/top?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:3001"
APP_PUBLIC_URL="http://localhost:3001"
JWT_ACCESS_SECRET="top-local-development-secret-change-in-production"
PASSWORD_RESET_OTP_SECRET="top-local-development-password-reset-secret-change-in-production"

# Defaults vigentes; TTL enteros positivos, cooldowns enteros no negativos.
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_OTP_RESEND_SECONDS=60
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Console no requiere SMTP localmente. Producción exige smtp, host, remitente y
# puerto válido (default 587); USER y PASSWORD se suministran juntos o se omiten.
# Puerto 465: TLS directo. Otros puertos: STARTTLS obligatorio en producción.
# No desactivar validación de certificados ni enviar correos reales en pruebas.
EMAIL_DELIVERY_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM="TOP <no-reply@example.com>"
# SMTP_USER=cuenta-smtp
# SMTP_PASSWORD=proporcionar-fuera-del-repositorio

# MinIO del Compose local: bucket creado por minio-init.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="top-resource-images"
S3_ACCESS_KEY="topminio"
S3_SECRET_KEY="topminiosecret"
S3_FORCE_PATH_STYLE=true

# Producción: JWT y OTP independientes, cada uno con al menos 32 bytes,
# generados con una fuente criptográfica segura fuera de la aplicación.
# La longitud no garantiza aleatoriedad. No usar los valores locales/ejemplos.
# DATABASE_URL PostgreSQL válida; APP_PUBLIC_URL y cada CORS_ORIGIN HTTPS
# explícitos, sin credenciales, query ni fragmento; CORS sin wildcard.
# Storage S3 completo y endpoints efectivos HTTPS. S3_PUBLIC_ENDPOINT es
# opcional y toma S3_ENDPOINT al omitirse. No incorporar secretos a la imagen,
# argumentos de build, archivos versionados ni variables VITE_*.
